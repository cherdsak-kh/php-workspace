# ========================================================
# PHP Multi-Version Hub - Environment Configuration
# ========================================================
# Copy this file to .env and adjust variables as needed.
# Docker Compose will read .env automatically.

# --- PHP Containers Web Ports ---
PHP56_PORT=5640
PHP74_PORT=7433
PHP80_PORT=8030
PHP81_PORT=8131
PHP82_PORT=8235
PHP83_PORT=8336
PHP84_PORT=8427
PHP85_PORT=8512

# --- Container Management Web App (Portainer CE) ---
PORTAINER_PORT=9000

# --- Database Gateway (Default: host-gateway connects to host MySQL) ---
DB_HOST=host-gateway
DB_PORT=3306

# --- phpMyAdmin Web UI Port ---
PMA_PORT=8081

# --- Optional Official MySQL 8.0 (--profile mysql) ---
# Used ONLY on machines without an existing mysql-sv on host
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=mysql_database
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password
